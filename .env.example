# Copy to .env and replace every value. .env is ignored by git.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
BOSS_KEY=replace-with-the-key-required-for-boss-sign-up
POSTGRES_PASSWORD=replace-with-a-database-password
# Comma separated: localhost plus this machine's LAN address, so other PCs can connect.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
# Any tool-capable Ollama model.
SLM_MODEL=qwen2.5:7b
