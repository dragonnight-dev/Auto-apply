# Copy to .env and replace the values. .env is ignored by git.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
BOSS_KEY=replace-with-the-key-required-for-boss-sign-up
# Comma separated: localhost plus this machine's LAN address, so other PCs can connect.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
# Any Ollama model that supports tools.
SLM_MODEL=qwen2.5:7b
# Optional: use a PostgreSQL server instead of the default SQLite file.
# POSTGRES_HOST=localhost
# POSTGRES_DB=autoapply
# POSTGRES_USER=autoapply
# POSTGRES_PASSWORD=replace-with-a-database-password
