{
  "manifest_version": 3,
  "name": "Auto Apply Client",
  "version": "1.0.0",
  "description": "Connects this browser to your Auto Apply server to open job pages and fill application forms.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Auto Apply" }
}
